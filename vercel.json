{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "prisma generate && next build",
  "git": { "deploymentEnabled": { "main": false } },
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "30 3 * * *" }]
}
