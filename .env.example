# Neon: use the POOLED host, e.g. ?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20 (connection_limit=1 only on serverless hosts like Vercel).
DATABASE_URL=
DIRECT_URL=
SESSION_SECRET=replace-with-64-random-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DOB_PEPPER=replace-with-64-random-chars-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# Mail: Brevo is tried first, then Resend. MAIL_FROM must be a sender verified with the provider.
BREVO_API_KEY=
MAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
GEMINI_API_KEY=
# Cloudflare R2 file storage (required on Vercel; leave empty locally to use STORAGE_DIR).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
POSTGRES_PASSWORD=change-me
DOMAIN=localhost
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Uploaded documents directory (a Docker volume in production).
STORAGE_DIR=./storage
# Auth for /api/cron/cleanup, sent as "Authorization: Bearer <value>" by whatever scheduler calls it (random 32+ chars).
CRON_SECRET=
# Max student sign-in attempts per public IP per 15 minutes. Many students share one campus IP, so keep it well above the cohort size (3000 for 1000 students).
LOGIN_IP_LIMIT=3000
# Header in which your hosting proxy puts the visitor's real IP (used for per-IP limits). Leave empty for x-real-ip (Railway).
# Only name a header that the proxy always overwrites, otherwise visitors can fake it.
CLIENT_IP_HEADER=
