DATABASE_URL=
DIRECT_URL=
SESSION_SECRET=replace-with-64-random-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DOB_PEPPER=replace-with-64-random-chars-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# Mail: Brevo is tried first, then Resend. MAIL_FROM must be a sender verified with the provider.
BREVO_API_KEY=
MAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
GEMINI_API_KEY=
# Cloudflare R2 file storage (required on Vercel; leave empty locally to use STORAGE_DIR).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
POSTGRES_PASSWORD=change-me
DOMAIN=localhost
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Uploaded documents directory (a Docker volume in production).
STORAGE_DIR=./storage
# Vercel Cron auth for /api/cron/cleanup (random 32+ chars).
CRON_SECRET=
# Max student sign-in attempts per public IP per 15 minutes (many students may share one campus IP). Default 600 (500 students + ~20% for typos/retries). Lower it if your cohort is smaller.
LOGIN_IP_LIMIT=600
