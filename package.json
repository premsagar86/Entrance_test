    "db:demo": "node --env-file=.env --import tsx prisma/seed-demo.ts",
    "loadtest:seed": "node --env-file=.env --import tsx scripts/loadtest/seed-load-students.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@prisma/client": "^5.22.0",
    "exceljs": "^4.4.0",
